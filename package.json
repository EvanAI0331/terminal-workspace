{
  "name": "terminal-workspace",
  "private": false,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "postinstall": "npm rebuild node-pty --build-from-source",
    "rebuild:pty": "npm rebuild node-pty --build-from-source",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "electron": "^42.2.0",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "smol-toml": "^1.6.1",
    "wait-on": "^9.0.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "description": "A cross-project multi-terminal desktop workspace for developers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvanAI0331/terminal-workspace.git"
  },
  "homepage": "https://github.com/EvanAI0331/terminal-workspace#readme",
  "bugs": {
    "url": "https://github.com/EvanAI0331/terminal-workspace/issues"
  },
  "keywords": [
    "terminal",
    "electron",
    "xterm",
    "pty",
    "developer-tools",
    "workspace",
    "multi-terminal"
  ]
}
