{
  "name": "terminal-workspace",
  "private": false,
  "version": "0.1.2",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "postinstall": "npm rebuild node-pty --build-from-source",
    "rebuild:pty": "npm rebuild node-pty --build-from-source",
    "build": "tsc -b && vite build",
    "pack:mac": "npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac zip --arm64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^9.2.1",
    "lucide-react": "^1.16.0",
    "node-pty": "^1.1.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "smol-toml": "^1.6.1",
    "wait-on": "^9.0.10",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "description": "Cross-project multi-terminal workspace for local development stacks.",
  "author": "EvanAI0331",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvanAI0331/terminal-workspace.git"
  },
  "homepage": "https://github.com/EvanAI0331/terminal-workspace#readme",
  "bugs": {
    "url": "https://github.com/EvanAI0331/terminal-workspace/issues"
  },
  "keywords": [
    "terminal",
    "electron",
    "xtermjs",
    "pty",
    "node-pty",
    "developer-tools",
    "devtools",
    "local-development",
    "workspace",
    "multi-terminal",
    "macos",
    "desktop-app"
  ],
  "build": {
    "appId": "dev.terminalworkspace.app",
    "productName": "Terminal Workspace",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "assets/TerminalTopology.icns",
      "target": [
        "zip"
      ]
    },
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  }
}
